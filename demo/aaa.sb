// 账户状态
AccountStatus = Offline | Online | Deleted

// 类型
Type = Sim | Recharge

// 错误码
Status = Ok(0) | Err(1) | Two(2) | Three(3) | Four(4) | Five(5) | Six(6) | Seven(7) | One(11)

// 状态A
StatusA = Ok(0)
    | One(1)
    | Two(2)
    | Three(3)
    | Four(4)
    | Five(5)
    | Six(6)
    | Seven(7)


//订单状态
ItemStatus = Offline | Online

//可否选号
SimPickPhone = No | Yes | Active(3) | Abcc(4)

//运营商
SimOperator = Zz(2) | Lt(3) | Yd | Dx | Gd | Xx | A(11) | B(12)

// 订单状态
// Pending      待处理
// Closed       已关闭
// Canceled     已取消
// Shipped      已发货
// Delivered    已送达
// Actived      已激活
// Settled      已结算
OrderStatus = Pending
            | Closed
            | Canceled
            | Shipped
            | Delivered
            | Actived
            | Settled

Recharge {
    // abcd
    id u32 "_id"
    type [OrderStatus]
    phone [text]
    si SimInfo
}

RechargeA {
    ...Recharge
    aid u32
}

RechargeB {
    ...Recharge
    bid u32
}

Sim{
    // SIM卡ID
    id  u32 "_id"
    type Type
    status  ItemStatus
    // 佣金
    commission u16
    // 供应商ID
    supplier  u32
    // 推广员ID
    aff  u32
    // 合约期(月), 0:长期
    contract_duration  u8
    name  text
    // 运营商
    operator  SimOperator
    // 月租
    monthly  u16
    // 通用流量
    flow_universal  u16
    // 定向流量
    flow_directional  u16
    // 流量是否结转
    can_move_flow  bool
    // 每月通话(分钟)
    call_month  u16
    call_price  u16
    // 每月短信(条)
    sms_month  u16
    sms_price  u16
    min_age  u8
    max_age  u8
    // 归属地, 0:随机, 1:收货地
    attribution  u32
    // 选号
    pick_phone  [SimPickPhone]
    // 首充渠道
    first_charge_link  text
    // 首充金额
    first_charge_money  text
    // 首充返额
    first_charge_return  text
    // 禁发区域
    ban_city  [u32]
    info  [SimInfo]
    // 套餐截图
    snapshot  [text]
}

SimInfo{
    id u32
    title text
    content text
    a bool
    b bool
    c bool
    d bool
    zip bin
}

SimOrder2{
    // SIM卡ID
    id  u32
    // 办理人姓名
    name  text
    // 联系电话
    phone  text
    // 身份证号
    id_no  text
    // 所在城市
    city_code  u32
    // 详细地址
    address  text
    // 新手机号码
    new_phone  text
}

SimOrder{
    id  u32
    account_id u32
    item_id u32
    // 办理人姓名
    name  text
    // 联系电话
    phone  text
    // 身份证号
    id_no  text
    // 所在城市
    city_code  u32
    // 详细地址
    address  text
    // 新手机号码
    new_phone  text
    // 佣金
    commission u16
    status OrderStatus
}

//获取用户的id
user.get_abc() => OrderStatus

//获取abcd
user.get_abcd(page u8, size u8) =>  OrderStatus

//设置sim信息
//无返回值
user.set_sim_info(info SimInfo) => nil

//获取数量
get_count(page u8) => u8

//获取bin
get_bin(page u8) => bin
