Color = Red(1) | Green(2) | Blue(3)

Item {
    id u32
    color Color
    tags [text]
    active bool
}

Envelope {
    item Item
    items [Item]
    note text
}

echo(env Envelope) => Envelope
echo_tail(env Envelope) => Envelope
get_color() => Color
get_bad_color() => Color
ping() => nil
ping_junk() => nil
pick(color Color) => Color
pick_bad(color Color) => Color
